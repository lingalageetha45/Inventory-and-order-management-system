{
  "info": {
    "name": "Inventory & Order Management System",
    "description": "Base URL: {{baseUrl}}\n1. Login\n2. Put access_token into collection variable token\n3. Use Admin/Staff for manage APIs, Customer for orders/payments/reviews",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000/api/v1" },
    { "key": "token", "value": "" },
    { "key": "product_id", "value": "1" },
    { "key": "category_id", "value": "1" },
    { "key": "order_id", "value": "1" },
    { "key": "payment_id", "value": "1" },
    { "key": "review_id", "value": "1" },
    { "key": "notification_id", "value": "1" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"John Customer\",\n  \"email\": \"customer@example.com\",\n  \"password\": \"customer123\",\n  \"phone\": \"9876543210\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"customer123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Electronics\",\n  \"description\": \"Electronic devices and accessories\",\n  \"status\": \"active\"\n}"
            },
            "url": "{{baseUrl}}/categories/"
          }
        },
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/categories/"
          }
        },
        {
          "name": "Get Category",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/categories/{{category_id}}"
          }
        },
        {
          "name": "Update Category",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Electronics Updated\",\n  \"description\": \"Updated description\",\n  \"status\": \"active\"\n}"
            },
            "url": "{{baseUrl}}/categories/{{category_id}}"
          }
        },
        {
          "name": "Delete Category",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/categories/{{category_id}}"
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Headphones\",\n  \"description\": \"Noise cancelling Bluetooth headphones\",\n  \"category_id\": 1,\n  \"price\": \"2999.00\",\n  \"sku\": \"EL-HP-001\",\n  \"stock_quantity\": 50,\n  \"status\": \"active\",\n  \"image\": null\n}"
            },
            "url": "{{baseUrl}}/products/"
          }
        },
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products/"
          }
        },
        {
          "name": "Get Product",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products/{{product_id}}"
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Headphones Pro\",\n  \"price\": \"3499.00\",\n  \"status\": \"active\"\n}"
            },
            "url": "{{baseUrl}}/products/{{product_id}}"
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/products/{{product_id}}"
          }
        }
      ]
    },
    {
      "name": "Inventory",
      "item": [
        {
          "name": "Create Inventory",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": 1,\n  \"current_stock\": 50,\n  \"minimum_stock_level\": 5,\n  \"maximum_stock_level\": 200\n}"
            },
            "url": "{{baseUrl}}/inventory/"
          }
        },
        {
          "name": "List Inventory",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/inventory/"
          }
        },
        {
          "name": "Get Inventory",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/inventory/{{product_id}}"
          }
        },
        {
          "name": "Update Inventory",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"minimum_stock_level\": 10,\n  \"maximum_stock_level\": 300\n}"
            },
            "url": "{{baseUrl}}/inventory/{{product_id}}"
          }
        },
        {
          "name": "Add Stock",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 20\n}"
            },
            "url": "{{baseUrl}}/inventory/{{product_id}}/add-stock"
          }
        },
        {
          "name": "Remove Stock",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 5\n}"
            },
            "url": "{{baseUrl}}/inventory/{{product_id}}/remove-stock"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"product_id\": 1, \"quantity\": 2 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/orders/"
          }
        },
        {
          "name": "List Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/orders/"
          }
        },
        {
          "name": "Get Order",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/orders/{{order_id}}"
          }
        },
        {
          "name": "Confirm Order",
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{baseUrl}}/orders/{{order_id}}/confirm"
          }
        },
        {
          "name": "Ship Order",
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{baseUrl}}/orders/{{order_id}}/ship"
          }
        },
        {
          "name": "Deliver Order",
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{baseUrl}}/orders/{{order_id}}/deliver"
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{baseUrl}}/orders/{{order_id}}/cancel"
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create Payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_id\": 1,\n  \"payment_method\": \"upi\"\n}"
            },
            "url": "{{baseUrl}}/payments/"
          }
        },
        {
          "name": "List Payments",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/payments/"
          }
        },
        {
          "name": "Get Payment",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/payments/{{payment_id}}"
          }
        },
        {
          "name": "Update Payment Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_status\": \"paid\"\n}"
            },
            "url": "{{baseUrl}}/payments/{{payment_id}}/status"
          }
        }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        {
          "name": "Create Review",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": 1,\n  \"order_id\": 1,\n  \"rating\": 5,\n  \"review\": \"Excellent product, fast delivery!\"\n}"
            },
            "url": "{{baseUrl}}/reviews/"
          }
        },
        {
          "name": "List Reviews",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/reviews/?product_id=1"
          }
        },
        {
          "name": "Get Review",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/reviews/{{review_id}}"
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Create Notification",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 1,\n  \"title\": \"Order Update\",\n  \"message\": \"Your order has been confirmed.\"\n}"
            },
            "url": "{{baseUrl}}/notifications/"
          }
        },
        {
          "name": "List Notifications",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/notifications/"
          }
        },
        {
          "name": "Get Notification",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/notifications/{{notification_id}}"
          }
        },
        {
          "name": "Mark as Read",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/notifications/{{notification_id}}/read"
          }
        }
      ]
    }
  ]
}